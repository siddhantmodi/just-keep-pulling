/ {
	aliases {
		load-cell-adc = &load_cell_adc;
		pmic-charger = &pmic_charger;
		pmic-regulators = &pmic_regulators;
		motion-sensor = &imu;
		status-led-red = &red_led;
		status-led-green = &green_led;
		status-led-blue = &blue_led;
	};

	/* The status LED on emulated GPIOs. */
	leds {
		compatible = "gpio-leds";

		red_led: red_led {
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
		};

		green_led: green_led {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		};

		blue_led: blue_led {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		};
	};
};

/* An emulated ADS1220 on native_sim's SPI emulator bus, /DRDY on an emulated GPIO. */

&spi0 {
	load_cell_adc: ads1220@0 {
		compatible = "jkp,ads1220";
		reg = <0>;
		spi-max-frequency = <2000000>;
		drdy-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
		low-side-power-switch;
	};
};

/*
 * An emulated nPM1300 on native_sim's I2C emulator bus, configured as on the
 * XIAO; Zephyr's own drivers run against it. The battery reads 3750 mV.
 */
&i2c0 {
	pmic: npm1300@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		pmic_charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4200000>;
			current-microamp = <500000>;
			dischg-limit-microamp = <1000000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <10000>;
			thermistor-beta = <3380>;
			charging-enable;
		};

		pmic_regulators: regulators {
			compatible = "nordic,npm1300-regulator";
		};
	};

	/* The IMU, as on the XIAO: Zephyr's emulated LSM6DSL, initialized by the app. */
	imu: lsm6dsl@6a {
		compatible = "st,lsm6dsl";
		reg = <0x6a>;
		irq-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		zephyr,deferred-init;
	};
};
