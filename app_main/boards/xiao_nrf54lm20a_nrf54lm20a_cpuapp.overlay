/*
 * The XIAO's nPM1300 PMIC, which the board's own devicetree leaves out. It is on
 * its own I2C pins (Seeed pinout: SDA P1.18, SCL P1.17). Serial instances 20-23
 * are taken by the board (console, XIAO UART, XIAO I2C, XIAO SPI), so it uses 24.
 */

&pinctrl {
	i2c24_default: i2c24_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 18)>,
				<NRF_PSEL(TWIM_SCL, 1, 17)>;
		};
	};

	i2c24_sleep: i2c24_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 18)>,
				<NRF_PSEL(TWIM_SCL, 1, 17)>;
			low-power-enable;
		};
	};
};

&i2c24 {
	status = "okay";
	pinctrl-0 = <&i2c24_default>;
	pinctrl-1 = <&i2c24_sleep>;
	pinctrl-names = "default", "sleep";

	npm1300_pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			/* 2000 mAh LiPo: 500 mA (0.25C) to 4.2 V, within a 500 mA USB budget. */
			term-microvolt = <4200000>;
			current-microamp = <500000>;
			vbus-limit-microamp = <500000>;
			dischg-limit-microamp = <1000000>;
			/* The XIAO's battery pads have no thermistor; the PMIC still stops on die temperature. */
			thermistor-ohms = <0>;
			thermistor-beta = <3380>;
			charging-enable;
		};
	};
};

/*
 * ADS1220 load-cell ADC on the XIAO SPI (SCK P1.04, MOSI P1.06, MISO P1.05),
 * /CS on P1.00 (D0) and /DRDY on P1.31 (D1). Ratiometric: REFP0/REFN0 across
 * the bridge excitation; bridge signal on AIN1/AIN2; bridge returned through
 * AIN3/REFN1 so the low-side switch cuts it while powered down.
 */
/ {
	aliases {
		load-cell-adc = &load_cell_adc;
	};
};

&spi23 {
	cs-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;

	load_cell_adc: ads1220@0 {
		compatible = "jkp,ads1220";
		reg = <0>;
		spi-max-frequency = <2000000>;
		drdy-gpios = <&gpio1 31 GPIO_ACTIVE_LOW>;
		low-side-power-switch;
	};
};

/*
 * Nordic's SoftDevice Controller, as on Nordic's own nRF54LM20 DK. Seeed's
 * board picks Zephyr's experimental software link layer, which conflicts with it.
 * The SoftDevice Controller's MPSL also needs the clock sources the DK enables
 * and Seeed's board leaves disabled (the XIAO has both crystals).
 */
/ {
	chosen {
		zephyr,bt-hci = &bt_hci_sdc;
	};
};

&bt_hci_controller {
	status = "disabled";
};

&xo {
	status = "okay";
};

&lfclk {
	status = "okay";
};

&xo24m {
	status = "okay";
};
