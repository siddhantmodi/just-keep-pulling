config APP_BLE_SVC
	bool "BLE service"
	depends on BT_PERIPHERAL && ZBUS && APP_IDENTITY_SVC
	help
	  Bluetooth: connectable advertising as Progressor_NNNN, connections,
	  and the GATT services: the Tindeq Progressor service (control point
	  writes are published to zbus; the measurement manager answers through
	  ble_svc::client()), the JustKeepPulling service, and the standard
	  Device Information (BT_DIS) and Battery (BT_BAS) services.

if APP_BLE_SVC

config APP_BLE_SVC_JKP
	bool "JustKeepPulling service"
	default y
	depends on APP_LOAD_CELL_SVC
	help
	  Our own GATT service, beside the Progressor one: calibration, the
	  sample rate and the full device ID, for any GATT client (e.g. nRF
	  Connect). Requests are published to zbus for the measurement manager.

config APP_BLE_SVC_MAX_QUEUED_NOTIFICATIONS
	int "Data point notifications queued at most"
	default 8
	help
	  Notifications handed to the Bluetooth stack and not yet sent. Beyond
	  this, send_progressor() drops the packet instead of waiting for a
	  buffer, so the measurement manager never blocks on a slow link.
	  BT_ATT_TX_COUNT must cover this plus ble_svc's reserve of 4 buffers
	  for other ATT traffic.

endif # APP_BLE_SVC

# Outside "if APP_BLE_SVC" so the unit test gets the log level too.
module = APP_BLE_SVC
module-str = ble_svc
source "subsys/logging/Kconfig.template.log_config"
