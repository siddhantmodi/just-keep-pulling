config APP_JKP_SVC
	bool "JustKeepPulling service"
	depends on BT_PERIPHERAL && ZBUS && APP_IDENTITY_SVC && APP_LOAD_CELL_SVC
	help
	  Our own GATT service, beside the Progressor one: calibration, the
	  sample rate and the full device ID, for any GATT client (e.g. nRF
	  Connect). Requests are published to zbus for the measurement manager.

# Outside "if APP_JKP_SVC" so the unit test gets the log level too.
module = APP_JKP_SVC
module-str = jkp_svc
source "subsys/logging/Kconfig.template.log_config"
