config APP_IDENTITY_SVC
	bool "Identity service"
	depends on SETTINGS
	help
	  The device's unique 6-byte ID: generated randomly on first boot and
	  saved in settings.

# Outside "if APP_IDENTITY_SVC" so the unit test gets the log level too.
module = APP_IDENTITY_SVC
module-str = identity_svc
