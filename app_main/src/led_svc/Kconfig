config APP_LED_SVC
	bool "LED service"
	depends on GPIO && FW_HAL
	depends on $(dt_alias_enabled,led0)
	help
	  Drives the board's led0 alias on/off.

# Outside "if APP_LED_SVC" so the unit test (which builds the Led class
# without the production instance) gets the log level too.
module = APP_LED_SVC
module-str = led_svc
source "subsys/logging/Kconfig.template.log_config"
