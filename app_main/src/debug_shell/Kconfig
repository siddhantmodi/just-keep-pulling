config APP_DEBUG_SHELL
	bool "Debug shell commands"
	default y
	depends on SHELL && APP_IDENTITY_SVC && APP_LOAD_CELL_SVC
	help
	  "jkp" shell commands to show and change the device ID and the sample
	  rate. Debug builds only: the shell is enabled by debug.conf.
