diff --git a/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.c b/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.c
new file mode 100644
index 000000000..f58de58f9
--- /dev/null
+++ b/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.c
@@ -0,0 +1,213 @@
+/*
+ * Copyright (c) 2026 Siddhant Modi
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define DT_DRV_COMPAT st_lsm6dsl
+
+#include <string.h>
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/emul.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/drivers/gpio/gpio_emul.h>
+#include <zephyr/drivers/i2c.h>
+#include <zephyr/drivers/i2c_emul.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/spinlock.h>
+
+#include "lsm6dsl.h"
+#include "lsm6dsl_emul.h"
+
+LOG_MODULE_REGISTER(lsm6dsl_emul, CONFIG_SENSOR_LOG_LEVEL);
+
+#define LSM6DSL_EMUL_REG_COUNT 0x80
+
+struct lsm6dsl_emul_cfg {
+	struct gpio_dt_spec int1;
+};
+
+struct lsm6dsl_emul_data {
+	struct k_spinlock lock;
+	uint8_t reg[LSM6DSL_EMUL_REG_COUNT];
+	uint8_t cur_reg;
+	bool int1;
+};
+
+static void lsm6dsl_emul_reset_regs(struct lsm6dsl_emul_data *data)
+{
+	memset(data->reg, 0, sizeof(data->reg));
+	data->reg[LSM6DSL_REG_WHO_AM_I] = LSM6DSL_VAL_WHO_AM_I;
+	data->reg[LSM6DSL_REG_CTRL3_C] = LSM6DSL_MASK_CTRL3_C_IF_INC;
+}
+
+static bool lsm6dsl_emul_int1_active(const struct lsm6dsl_emul_data *data)
+{
+	return (data->reg[LSM6DSL_REG_WAKE_UP_SRC] & LSM6DSL_MASK_WAKE_UP_SRC_WU_IA) != 0U &&
+	       (data->reg[LSM6DSL_REG_MD1_CFG] & LSM6DSL_MASK_MD1_CFG_INT1_WU) != 0U;
+}
+
+/* Drive INT1 only when its level changes: until then the driver may not have configured
+ * the pin as an input.
+ */
+static void lsm6dsl_emul_update_int1(const struct emul *target, bool active)
+{
+	const struct lsm6dsl_emul_cfg *cfg = target->cfg;
+	struct lsm6dsl_emul_data *data = target->data;
+	bool changed = false;
+
+	K_SPINLOCK(&data->lock) {
+		changed = data->int1 != active;
+		data->int1 = active;
+	}
+
+	if (changed && cfg->int1.port != NULL) {
+		gpio_emul_input_set(cfg->int1.port, cfg->int1.pin, active ? 1 : 0);
+	}
+}
+
+static void lsm6dsl_emul_write_reg(struct lsm6dsl_emul_data *data, uint8_t reg, uint8_t val)
+{
+	switch (reg) {
+	case LSM6DSL_REG_WHO_AM_I:
+	case LSM6DSL_REG_WAKE_UP_SRC:
+	case LSM6DSL_REG_STATUS_REG:
+		/* Read-only */
+		break;
+	case LSM6DSL_REG_CTRL3_C:
+		if ((val & LSM6DSL_MASK_CTRL3_C_SW_RESET) != 0U) {
+			lsm6dsl_emul_reset_regs(data);
+		} else {
+			/* BOOT completes at once and clears itself */
+			data->reg[reg] = val & ~LSM6DSL_MASK_CTRL3_C_BOOT;
+		}
+		break;
+	default:
+		data->reg[reg] = val;
+		break;
+	}
+}
+
+static uint8_t lsm6dsl_emul_read_reg(struct lsm6dsl_emul_data *data, uint8_t reg)
+{
+	uint8_t val = data->reg[reg];
+
+	if (reg == LSM6DSL_REG_WAKE_UP_SRC) {
+		/* Reading the source clears the wake-up event */
+		data->reg[reg] = 0;
+	}
+
+	return val;
+}
+
+static int lsm6dsl_emul_transfer_i2c(const struct emul *target, struct i2c_msg *msgs, int num_msgs,
+				     int addr)
+{
+	struct lsm6dsl_emul_data *data = target->data;
+	bool int1 = false;
+
+	ARG_UNUSED(addr);
+
+	K_SPINLOCK(&data->lock) {
+		for (int m = 0; m < num_msgs; m++) {
+			struct i2c_msg *msg = &msgs[m];
+			uint32_t i = 0;
+
+			if ((msg->flags & I2C_MSG_READ) != 0U) {
+				for (; i < msg->len; i++) {
+					msg->buf[i] = lsm6dsl_emul_read_reg(
+						data, data->cur_reg++ % LSM6DSL_EMUL_REG_COUNT);
+				}
+				continue;
+			}
+
+			/* A write starts with the register address, unless it continues the
+			 * previous write message (e.g. a burst write's data)
+			 */
+			if (m == 0 || (msg->flags & I2C_MSG_RESTART) != 0U ||
+			    (msgs[m - 1].flags & I2C_MSG_READ) != 0U) {
+				if (msg->len == 0U) {
+					continue;
+				}
+				data->cur_reg = msg->buf[i++];
+			}
+			for (; i < msg->len; i++) {
+				lsm6dsl_emul_write_reg(data,
+						       data->cur_reg++ % LSM6DSL_EMUL_REG_COUNT,
+						       msg->buf[i]);
+			}
+		}
+		int1 = lsm6dsl_emul_int1_active(data);
+	}
+
+	lsm6dsl_emul_update_int1(target, int1);
+
+	return 0;
+}
+
+void lsm6dsl_emul_set_reg(const struct emul *target, uint8_t reg_addr, const uint8_t *val,
+			  size_t count)
+{
+	struct lsm6dsl_emul_data *data = target->data;
+
+	__ASSERT_NO_MSG(reg_addr + count <= LSM6DSL_EMUL_REG_COUNT);
+	K_SPINLOCK(&data->lock) {
+		memcpy(&data->reg[reg_addr], val, count);
+	}
+}
+
+void lsm6dsl_emul_get_reg(const struct emul *target, uint8_t reg_addr, uint8_t *val, size_t count)
+{
+	struct lsm6dsl_emul_data *data = target->data;
+
+	__ASSERT_NO_MSG(reg_addr + count <= LSM6DSL_EMUL_REG_COUNT);
+	K_SPINLOCK(&data->lock) {
+		memcpy(val, &data->reg[reg_addr], count);
+	}
+}
+
+void lsm6dsl_emul_wake_up(const struct emul *target)
+{
+	struct lsm6dsl_emul_data *data = target->data;
+	bool int1 = false;
+
+	K_SPINLOCK(&data->lock) {
+		bool accel_on =
+			(data->reg[LSM6DSL_REG_CTRL1_XL] & LSM6DSL_MASK_CTRL1_XL_ODR_XL) != 0U;
+		bool int_enabled = (data->reg[LSM6DSL_REG_TAP_CFG] &
+				    LSM6DSL_MASK_TAP_CFG_INTERRPUTS_ENABLE) != 0U;
+
+		if (accel_on && int_enabled) {
+			data->reg[LSM6DSL_REG_WAKE_UP_SRC] =
+				LSM6DSL_MASK_WAKE_UP_SRC_WU_IA | LSM6DSL_MASK_WAKE_UP_SRC_X_WU;
+		}
+		int1 = lsm6dsl_emul_int1_active(data);
+	}
+
+	lsm6dsl_emul_update_int1(target, int1);
+}
+
+static int lsm6dsl_emul_init(const struct emul *target, const struct device *parent)
+{
+	struct lsm6dsl_emul_data *data = target->data;
+
+	ARG_UNUSED(parent);
+
+	lsm6dsl_emul_reset_regs(data);
+
+	return 0;
+}
+
+static const struct i2c_emul_api lsm6dsl_emul_api_i2c = {
+	.transfer = lsm6dsl_emul_transfer_i2c,
+};
+
+#define LSM6DSL_EMUL(n)                                                                            \
+	static struct lsm6dsl_emul_data lsm6dsl_emul_data_##n;                                     \
+	static const struct lsm6dsl_emul_cfg lsm6dsl_emul_cfg_##n = {                              \
+		.int1 = GPIO_DT_SPEC_INST_GET_OR(n, irq_gpios, {0}),                               \
+	};                                                                                         \
+	EMUL_DT_INST_DEFINE(n, lsm6dsl_emul_init, &lsm6dsl_emul_data_##n, &lsm6dsl_emul_cfg_##n,   \
+			    &lsm6dsl_emul_api_i2c, NULL)
+
+DT_INST_FOREACH_STATUS_OKAY(LSM6DSL_EMUL)
diff --git a/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.h b/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.h
new file mode 100644
index 000000000..0940de152
--- /dev/null
+++ b/drivers/sensor/st/lsm6dsl/lsm6dsl_emul.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026 Siddhant Modi
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_DRIVERS_SENSOR_LSM6DSL_LSM6DSL_EMUL_H_
+#define ZEPHYR_DRIVERS_SENSOR_LSM6DSL_LSM6DSL_EMUL_H_
+
+#include <zephyr/drivers/emul.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Set one or more register values
+ *
+ * @param target The target emulator to modify
+ * @param reg_addr The starting address of the registers to modify
+ * @param val One or more bytes to write to the registers
+ * @param count The number of bytes to write
+ */
+void lsm6dsl_emul_set_reg(const struct emul *target, uint8_t reg_addr, const uint8_t *val,
+			  size_t count);
+
+/**
+ * @brief Get the values of one or more registers
+ *
+ * @param target The target emulator to read
+ * @param reg_addr The starting address of the registers to read
+ * @param val Buffer to write the register values into
+ * @param count The number of bytes to read
+ */
+void lsm6dsl_emul_get_reg(const struct emul *target, uint8_t reg_addr, uint8_t *val, size_t count);
+
+/**
+ * @brief Report a wake-up event (motion above the threshold)
+ *
+ * Takes effect only while the accelerometer is on and interrupts are enabled,
+ * as on the device: sets the wake-up source register and, if the wake-up
+ * interrupt is routed to INT1, drives INT1 high until the source is read.
+ *
+ * @param target The target emulator
+ */
+void lsm6dsl_emul_wake_up(const struct emul *target);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_DRIVERS_SENSOR_LSM6DSL_LSM6DSL_EMUL_H_ */
diff --git a/drivers/sensor/st/lsm6dsl/lsm6dsl_trigger.c b/drivers/sensor/st/lsm6dsl/lsm6dsl_trigger.c
index 0c3b1d377..167e56ed7 100644
--- a/drivers/sensor/st/lsm6dsl/lsm6dsl_trigger.c
+++ b/drivers/sensor/st/lsm6dsl/lsm6dsl_trigger.c
@@ -41,14 +41,35 @@ static inline void handle_irq(const struct device *dev)
 #endif
 }
 
+static int route_data_ready(const struct device *dev, bool enable)
+{
+	struct lsm6dsl_data *drv_data = dev->data;
+	uint8_t mask = LSM6DSL_MASK_INT1_CTRL_DRDY_XL | LSM6DSL_MASK_INT1_CTRL_DRDY_G;
+
+	return drv_data->hw_tf->update_reg(dev, LSM6DSL_REG_INT1_CTRL, mask, enable ? mask : 0);
+}
+
+static int route_wake_up(const struct device *dev, bool enable)
+{
+	struct lsm6dsl_data *drv_data = dev->data;
+
+	if (drv_data->hw_tf->update_reg(dev, LSM6DSL_REG_TAP_CFG,
+					LSM6DSL_MASK_TAP_CFG_INTERRPUTS_ENABLE,
+					enable ? LSM6DSL_MASK_TAP_CFG_INTERRPUTS_ENABLE : 0) < 0) {
+		return -EIO;
+	}
+
+	return drv_data->hw_tf->update_reg(dev, LSM6DSL_REG_MD1_CFG, LSM6DSL_MASK_MD1_CFG_INT1_WU,
+					   enable ? LSM6DSL_MASK_MD1_CFG_INT1_WU : 0);
+}
+
 int lsm6dsl_trigger_set(const struct device *dev,
 			const struct sensor_trigger *trig,
 			sensor_trigger_handler_t handler)
 {
 	const struct lsm6dsl_config *config = dev->config;
 	struct lsm6dsl_data *drv_data = dev->data;
-
-	__ASSERT_NO_MSG(trig->type == SENSOR_TRIG_DATA_READY);
+	int ret;
 
 	/* If irq_gpio is not configured in DT just return error */
 	if (!config->int_gpio.port) {
@@ -56,14 +77,30 @@ int lsm6dsl_trigger_set(const struct device *dev,
 		return -ENOTSUP;
 	}
 
+	if (trig->type != SENSOR_TRIG_DATA_READY && trig->type != SENSOR_TRIG_MOTION) {
+		return -ENOTSUP;
+	}
+
 	setup_irq(dev, false);
 
-	drv_data->data_ready_handler = handler;
-	if (handler == NULL) {
-		return 0;
+	if (trig->type == SENSOR_TRIG_DATA_READY) {
+		drv_data->data_ready_handler = handler;
+		drv_data->data_ready_trigger = trig;
+		ret = route_data_ready(dev, handler != NULL);
+	} else {
+		drv_data->motion_handler = handler;
+		drv_data->motion_trigger = trig;
+		ret = route_wake_up(dev, handler != NULL);
 	}
 
-	drv_data->data_ready_trigger = trig;
+	if (ret < 0) {
+		LOG_ERR("Could not route the interrupt.");
+		return -EIO;
+	}
+
+	if (drv_data->data_ready_handler == NULL && drv_data->motion_handler == NULL) {
+		return 0;
+	}
 
 	setup_irq(dev, true);
 	if (gpio_pin_get_dt(&config->int_gpio) > 0) {
@@ -73,6 +110,36 @@ int lsm6dsl_trigger_set(const struct device *dev,
 	return 0;
 }
 
+int lsm6dsl_wake_up_threshold_set(const struct device *dev, const struct sensor_value *val)
+{
+	struct lsm6dsl_data *drv_data = dev->data;
+	/* One step of the threshold is 1/64 of the full scale, i.e. 2^9 LSBs */
+	int64_t step_ug = (int64_t)(drv_data->accel_sensitivity * 512.0f);
+	int64_t threshold = (sensor_ms2_to_ug(val) + step_ug / 2) / step_ug;
+
+	if (threshold < 0 || threshold > LSM6DSL_MASK_WAKE_UP_THS_WK_THS) {
+		return -EINVAL;
+	}
+
+	return drv_data->hw_tf->update_reg(dev, LSM6DSL_REG_WAKE_UP_THS,
+					   LSM6DSL_MASK_WAKE_UP_THS_WK_THS,
+					   (uint8_t)threshold << LSM6DSL_SHIFT_WAKE_UP_THS_WK_THS);
+}
+
+int lsm6dsl_wake_up_duration_set(const struct device *dev, const struct sensor_value *val)
+{
+	struct lsm6dsl_data *drv_data = dev->data;
+
+	/* In samples at the accelerometer's data rate */
+	if (val->val1 < 0 || val->val1 > 3) {
+		return -EINVAL;
+	}
+
+	return drv_data->hw_tf->update_reg(dev, LSM6DSL_REG_WAKE_UP_DUR,
+					   LSM6DSL_MASK_WAKE_UP_DUR_WAKE_DUR,
+					   val->val1 << LSM6DSL_SHIFT_WAKE_UP_DUR_WAKE_DUR);
+}
+
 static void lsm6dsl_gpio_callback(const struct device *dev,
 				  struct gpio_callback *cb, uint32_t pins)
 {
@@ -87,8 +154,28 @@ static void lsm6dsl_gpio_callback(const struct device *dev,
 static void lsm6dsl_thread_cb(const struct device *dev)
 {
 	struct lsm6dsl_data *drv_data = dev->data;
+	uint8_t status = LSM6DSL_MASK_STATUS_REG_XLDA | LSM6DSL_MASK_STATUS_REG_GDA;
+
+	if (drv_data->motion_handler != NULL) {
+		uint8_t wake_up_src = 0;
+
+		/* Reading the source also clears a latched wake-up interrupt */
+		if (drv_data->hw_tf->read_reg(dev, LSM6DSL_REG_WAKE_UP_SRC, &wake_up_src) < 0) {
+			LOG_ERR("Could not read the wake-up source.");
+		} else if ((wake_up_src & LSM6DSL_MASK_WAKE_UP_SRC_WU_IA) != 0U) {
+			drv_data->motion_handler(dev, drv_data->motion_trigger);
+		}
+
+		/* The interrupt may be either: only report data ready if there is new data */
+		if (drv_data->data_ready_handler != NULL &&
+		    drv_data->hw_tf->read_reg(dev, LSM6DSL_REG_STATUS_REG, &status) < 0) {
+			LOG_ERR("Could not read the status.");
+			status = 0;
+		}
+	}
 
-	if (drv_data->data_ready_handler != NULL) {
+	if (drv_data->data_ready_handler != NULL &&
+	    (status & (LSM6DSL_MASK_STATUS_REG_XLDA | LSM6DSL_MASK_STATUS_REG_GDA)) != 0U) {
 		drv_data->data_ready_handler(dev,
