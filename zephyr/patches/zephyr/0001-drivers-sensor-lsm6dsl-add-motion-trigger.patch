diff --git a/tests/drivers/sensor/lsm6dsl/src/main.c b/tests/drivers/sensor/lsm6dsl/src/main.c
new file mode 100644
index 000000000..58b4821b8
--- /dev/null
+++ b/tests/drivers/sensor/lsm6dsl/src/main.c
@@ -0,0 +1,166 @@
+/*
+ * Copyright (c) 2026 Siddhant Modi
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/drivers/emul.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/drivers/sensor.h>
+#include <zephyr/kernel.h>
+#include <zephyr/ztest.h>
+
+#include "lsm6dsl.h"
+#include "lsm6dsl_emul.h"
+
+#define LSM6DSL_NODE DT_NODELABEL(lsm6dsl)
+
+static const struct device *const dev = DEVICE_DT_GET(LSM6DSL_NODE);
+static const struct emul *const emul = EMUL_DT_GET(LSM6DSL_NODE);
+static const struct gpio_dt_spec int1 = GPIO_DT_SPEC_GET(LSM6DSL_NODE, irq_gpios);
+
+static K_SEM_DEFINE(motion_sem, 0, 1);
+static K_SEM_DEFINE(data_ready_sem, 0, 1);
+
+static void motion_handler(const struct device *sensor, const struct sensor_trigger *trig)
+{
+	zassert_equal(sensor, dev);
+	zassert_equal(trig->type, SENSOR_TRIG_MOTION);
+	k_sem_give(&motion_sem);
+}
+
+static void data_ready_handler(const struct device *sensor, const struct sensor_trigger *trig)
+{
+	ARG_UNUSED(sensor);
+	zassert_equal(trig->type, SENSOR_TRIG_DATA_READY);
+	k_sem_give(&data_ready_sem);
+}
+
+static const struct sensor_trigger motion_trig = {
+	.type = SENSOR_TRIG_MOTION,
+	.chan = SENSOR_CHAN_ACCEL_XYZ,
+};
+
+static const struct sensor_trigger data_ready_trig = {
+	.type = SENSOR_TRIG_DATA_READY,
+	.chan = SENSOR_CHAN_ACCEL_XYZ,
+};
+
+static uint8_t get_reg(uint8_t reg)
+{
+	uint8_t val;
+
+	lsm6dsl_emul_get_reg(emul, reg, &val, 1);
+
+	return val;
+}
+
+static void start_accel(void)
+{
+	struct sensor_value odr = {.val1 = 26};
+
+	zassert_ok(
+		sensor_attr_set(dev, SENSOR_CHAN_ACCEL_XYZ, SENSOR_ATTR_SAMPLING_FREQUENCY, &odr));
+}
+
+static void lsm6dsl_before(void *fixture)
+{
+	ARG_UNUSED(fixture);
+
+	(void)sensor_trigger_set(dev, &motion_trig, NULL);
+	(void)sensor_trigger_set(dev, &data_ready_trig, NULL);
+	k_sem_reset(&motion_sem);
+	k_sem_reset(&data_ready_sem);
+}
+
+ZTEST(lsm6dsl, test_no_interrupt_routed_without_triggers)
+{
+	zassert_true(device_is_ready(dev));
+	zassert_equal(get_reg(LSM6DSL_REG_INT1_CTRL), 0);
+	zassert_equal(get_reg(LSM6DSL_REG_MD1_CFG), 0);
+}
+
+ZTEST(lsm6dsl, test_slope_threshold_sets_wake_up_threshold)
+{
+	/* 2 steps of 1/64 of +/-2 g, i.e. 62.5 mg */
+	struct sensor_value threshold;
+
+	sensor_ug_to_ms2(62500, &threshold);
+	zassert_ok(sensor_attr_set(dev, SENSOR_CHAN_ACCEL_XYZ, SENSOR_ATTR_SLOPE_TH, &threshold));
+	zassert_equal(get_reg(LSM6DSL_REG_WAKE_UP_THS) & LSM6DSL_MASK_WAKE_UP_THS_WK_THS, 2);
+}
+
+ZTEST(lsm6dsl, test_slope_threshold_out_of_range)
+{
+	struct sensor_value threshold;
+
+	sensor_g_to_ms2(3, &threshold);
+	zassert_equal(sensor_attr_set(dev, SENSOR_CHAN_ACCEL_XYZ, SENSOR_ATTR_SLOPE_TH, &threshold),
+		      -EINVAL);
+}
+
+ZTEST(lsm6dsl, test_slope_duration_sets_wake_up_duration)
+{
+	struct sensor_value duration = {.val1 = 2};
+
+	zassert_ok(sensor_attr_set(dev, SENSOR_CHAN_ACCEL_XYZ, SENSOR_ATTR_SLOPE_DUR, &duration));
+	zassert_equal(get_reg(LSM6DSL_REG_WAKE_UP_DUR) & LSM6DSL_MASK_WAKE_UP_DUR_WAKE_DUR,
+		      2 << LSM6DSL_SHIFT_WAKE_UP_DUR_WAKE_DUR);
+
+	duration.val1 = 4;
+	zassert_equal(sensor_attr_set(dev, SENSOR_CHAN_ACCEL_XYZ, SENSOR_ATTR_SLOPE_DUR, &duration),
+		      -EINVAL);
+}
+
+ZTEST(lsm6dsl, test_motion_trigger_routes_wake_up_to_int1)
+{
+	zassert_ok(sensor_trigger_set(dev, &motion_trig, motion_handler));
+	zassert_true(get_reg(LSM6DSL_REG_MD1_CFG) & LSM6DSL_MASK_MD1_CFG_INT1_WU);
+	zassert_true(get_reg(LSM6DSL_REG_TAP_CFG) & LSM6DSL_MASK_TAP_CFG_INTERRPUTS_ENABLE);
+	zassert_equal(get_reg(LSM6DSL_REG_INT1_CTRL), 0, "data ready must stay off INT1");
+
+	zassert_ok(sensor_trigger_set(dev, &motion_trig, NULL));
+	zassert_false(get_reg(LSM6DSL_REG_MD1_CFG) & LSM6DSL_MASK_MD1_CFG_INT1_WU);
+}
+
+ZTEST(lsm6dsl, test_motion_calls_handler)
+{
+	start_accel();
+	zassert_ok(sensor_trigger_set(dev, &motion_trig, motion_handler));
+
+	lsm6dsl_emul_wake_up(emul);
+
+	zassert_ok(k_sem_take(&motion_sem, K_MSEC(100)));
+	/* The handler's read of the source releases INT1 */
+	zassert_equal(gpio_pin_get_dt(&int1), 0);
+	zassert_equal(k_sem_take(&data_ready_sem, K_NO_WAIT), -EBUSY);
+}
+
+ZTEST(lsm6dsl, test_no_motion_without_handler)
+{
+	start_accel();
+
+	lsm6dsl_emul_wake_up(emul);
+
+	zassert_equal(k_sem_take(&motion_sem, K_MSEC(50)), -EAGAIN);
+}
+
+ZTEST(lsm6dsl, test_data_ready_trigger_routes_data_ready_to_int1)
+{
+	zassert_ok(sensor_trigger_set(dev, &data_ready_trig, data_ready_handler));
+	zassert_equal(get_reg(LSM6DSL_REG_INT1_CTRL),
+		      LSM6DSL_MASK_INT1_CTRL_DRDY_XL | LSM6DSL_MASK_INT1_CTRL_DRDY_G);
+
+	zassert_ok(sensor_trigger_set(dev, &data_ready_trig, NULL));
+	zassert_equal(get_reg(LSM6DSL_REG_INT1_CTRL), 0);
+}
+
+ZTEST(lsm6dsl, test_unsupported_trigger)
+{
+	struct sensor_trigger trig = {.type = SENSOR_TRIG_TAP, .chan = SENSOR_CHAN_ACCEL_XYZ};
+
+	zassert_equal(sensor_trigger_set(dev, &trig, motion_handler), -ENOTSUP);
+}
+
+ZTEST_SUITE(lsm6dsl, NULL, NULL, lsm6dsl_before, NULL, NULL);
